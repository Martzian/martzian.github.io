---
import type { Lang } from '../../data/site';
import { ui } from '../../i18n/ui';
import { asset } from '../../i18n/paths';
import hof from '../../data/hall-of-fame.json';
import data from '../../data/challenges.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].challenges;
const challengeName = (id: string | null) => {
  const c = id ? data.challenges.find((x) => x.id === id) : null;
  return c ? (c.title as Record<string, string>)[lang] : t.placeholderChallenge;
};
---
<section class="hof" aria-labelledby="hof-title">
  <div class="hof__head reveal">
    <p class="kicker" style="letter-spacing:.28em">{t.hofK}</p>
    <h2 id="hof-title">HALL OF FAME</h2>
    <p class="muted">{t.hofP}</p>
  </div>
  <ol class="hof__pods">
    {hof.entries.map((e, i) => (
      <li class="pod reveal" data-rank={e.rank} style={`transition-delay:${i * 120}ms`}>
        <span class="pod__cable" aria-hidden="true"></span>
        <span class="pod__portrait">
          {e.avatar ? <img src={asset(e.avatar)} alt={e.name} width="120" height="120" loading="lazy" /> : (
            <svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true" fill="none" stroke="#71808C" stroke-width="1.4"><circle cx="22" cy="16" r="8"></circle><path d="M8 40 C 10 30, 34 30, 36 40"></path></svg>
          )}
        </span>
        {!e.avatar && <span class="pod__ph mono">{t.photo}</span>}
        <span class="pod__rank">{String(e.rank).padStart(2, '0')}</span>
        <span class="pod__name">{e.name}</span>
        <span class="pod__of">{t.winnerOf} {challengeName(e.challengeId)}</span>
        <span class="pod__badge mono">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 1 L8.8 5 L13 5.4 L9.8 8.2 L10.8 12.5 L7 10.2 L3.2 12.5 L4.2 8.2 L1 5.4 L5.2 5 Z"></path></svg>
          {e.badge[lang as 'es' | 'en']}
        </span>
      </li>
    ))}
  </ol>
</section>

<style>
  .hof { position: relative; padding: 100px var(--edge) 120px; background: radial-gradient(ellipse 60% 70% at 50% 60%, #22080b 0%, #080808 70%); border-top: 1px solid var(--line-soft); overflow: hidden; }
  .hof__head { text-align: center; }
  .hof__head h2 { margin-top: 14px; font-size: clamp(56px, 8vw, 96px); }
  .hof__head p.muted { margin: 18px auto 0; max-width: 520px; font-size: 15px; line-height: 1.65; }
  .hof__pods { display: flex; justify-content: center; align-items: flex-end; gap: 24px; margin: 64px 0 0; padding: 60px 0 0; list-style: none; }
  .pod {
    --bd: rgba(113, 128, 140, 0.45); --line: #71808C; --glow: rgba(113, 128, 140, 0.12); --rank: var(--muted-2); --h: 480px;
    position: relative; width: 320px; height: var(--h); border: 1px solid var(--bd); border-radius: 160px 160px 0 0;
    background: linear-gradient(180deg, rgba(113, 128, 140, 0.08) 0%, rgba(8, 8, 8, 0.9) 60%);
    display: flex; flex-direction: column; align-items: center; padding: 32px 24px; text-align: center;
    transition: transform 0.4s var(--ease), box-shadow 0.4s, opacity 0.9s var(--ease);
  }
  .pod[data-rank='1'] { --bd: var(--red); --line: var(--red); --glow: rgba(255, 55, 55, 0.35); --rank: var(--red); --h: 580px; }
  .pod[data-rank='2'] { --h: 520px; }
  .pod:hover { transform: translateY(-6px); box-shadow: 0 0 80px rgba(255, 55, 55, 0.18); }
  .pod__cable { position: absolute; left: 50%; top: -60px; width: 2px; height: 60px; background: linear-gradient(180deg, transparent, var(--line)); }
  .pod[data-rank='1'] .pod__cable::after { content: ''; position: absolute; left: -2px; width: 6px; height: 10px; border-radius: 3px; background: var(--red); box-shadow: 0 0 10px var(--red); animation: drop 2.4s ease-in infinite; }
  @keyframes drop { from { top: 0; opacity: 1; } to { top: 60px; opacity: 0; } }
  .pod__portrait {
    margin-top: 24px; width: 120px; height: 120px; border-radius: 50%; border: 1px solid var(--bd); overflow: hidden;
    background: radial-gradient(circle at 50% 35%, #34383D, #111214 70%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 60px var(--glow);
  }
  .pod__portrait img { width: 100%; height: 100%; object-fit: cover; }
  .pod__ph { margin-top: 10px; font-size: 10px; color: var(--steel); }
  .pod__rank { margin-top: 18px; font-family: var(--f-display); font-weight: 800; font-size: 64px; line-height: 1; color: var(--rank); }
  .pod__name { margin-top: 8px; font-family: var(--f-display); font-weight: 700; font-size: 28px; letter-spacing: 0.04em; }
  .pod__of { margin-top: 6px; font-size: 13px; color: var(--muted); }
  .pod__badge { margin-top: auto; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--bd); font-size: 10px; color: var(--white); }
  .pod__badge svg { color: var(--line); }
  @media (max-width: 1060px) { .pod { width: 280px; } }
  @media (max-width: 900px) {
    .hof { padding-top: 72px; padding-bottom: 80px; }
    .hof__pods { flex-direction: column; align-items: center; gap: 72px; }
    .pod { width: min(340px, 100%); height: auto; min-height: 400px; }
    .pod[data-rank='1'] { order: -1; }
    .pod__badge { margin-top: 24px; }
  }
</style>
