---
import type { Lang } from '../../data/site';
import { openModules, sealedModules } from '../../data/modules';
import { ui } from '../../i18n/ui';
import { href } from '../../i18n/paths';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].home;
const g = ui[lang];
---
<section id="facility" class="facility wrap" aria-labelledby="facility-title">
  <div class="facility__head reveal">
    <div>
      <p class="kicker">{t.mapK}</p>
      <h2 id="facility-title">{t.mapH}</h2>
    </div>
    <p class="muted facility__p">{t.mapP}</p>
  </div>

  <ul class="facility__grid">
    {openModules.map((m, i) => (
      <li class="reveal" style={`transition-delay:${i * 80}ms`}>
        <a href={href(lang, m.slug)} class="chamber" data-cursor={t.enter.replace(' →', '')}>
          <span class="chamber__door" aria-hidden="true"><span></span><span></span></span>
          <span class="chamber__top mono"><span>{g.chamber} {m.n}</span><span class="chamber__open"><span class="dot"></span>{t.openTag}</span></span>
          <span class="chamber__num" aria-hidden="true">{m.n}</span>
          <span class="chamber__body">
            <span class="kicker" style="font-size:11px;letter-spacing:.2em">{m.code[lang]}</span>
            <span class="chamber__name">{m.name[lang]}</span>
            <span class="chamber__desc">{m.desc[lang]}</span>
            <span class="chamber__enter mono">{t.enter}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="facility__divider mono reveal"><span>{t.sealedHead}</span><span class="line"></span></div>
  <ul class="facility__grid">
    {sealedModules.map((m) => (
      <li class="sealed reveal">
        <span class="sealed__top mono"><span>SECTOR {m.n}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="#71808C" stroke-width="1.3"><rect x="2.5" y="6" width="9" height="6.5"></rect><path d="M4.5 6 V4 a2.5 2.5 0 0 1 5 0 V6"></path></svg></span>
        <span class="sealed__name">{m.name[lang]}</span>
        <span class="sealed__desc">{m.desc[lang]}</span>
        <span class="mono sealed__tag">{t.sealedTag}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .facility { padding-top: 120px; padding-bottom: 100px; }
  .facility__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; margin-bottom: 56px; }
  .facility__head h2 { margin-top: 14px; font-size: clamp(48px, 6vw, 72px); font-weight: 700; line-height: 0.95; }
  .facility__p { max-width: 420px; font-size: 15px; line-height: 1.65; }
  .facility__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .chamber {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 380px; height: 100%; padding: 28px;
    border: 1px solid rgba(113, 128, 140, 0.28); background: linear-gradient(180deg, #101214 0%, #0a0a0b 100%); overflow: hidden;
    transition: border-color 0.35s, transform 0.35s var(--ease), background 0.35s;
  }
  .chamber:hover, .chamber:focus-visible { border-color: var(--red); transform: translateY(-4px); background: var(--black-red); color: var(--white); }
  .chamber__door { position: absolute; inset: 0; display: flex; pointer-events: none; }
  .chamber__door span { flex: 1; border-right: 1px solid rgba(255, 55, 55, 0.1); transition: transform 0.6s var(--ease), background 0.6s; }
  .chamber__door span + span { border-right: 0; border-left: 1px solid rgba(255, 55, 55, 0.1); }
  .chamber:hover .chamber__door span { border-color: rgba(255, 55, 55, 0.35); }
  .chamber:hover .chamber__door span:first-child { transform: translateX(-12px); }
  .chamber:hover .chamber__door span:last-child { transform: translateX(12px); }
  .chamber > span:not(.chamber__door) { position: relative; }
  .chamber__top { display: flex; justify-content: space-between; font-size: 11px; color: var(--steel); }
  .chamber__open { display: flex; align-items: center; gap: 8px; color: var(--white); }
  .chamber__open .dot { width: 6px; height: 6px; }
  .chamber__num { font-family: var(--f-display); font-weight: 800; font-size: 120px; line-height: 1; color: rgba(215, 215, 215, 0.06); transition: color 0.35s; }
  .chamber:hover .chamber__num { color: rgba(255, 55, 55, 0.14); }
  .chamber__body { display: flex; flex-direction: column; gap: 10px; }
  .chamber__name { font-family: var(--f-display); font-weight: 700; font-size: 36px; letter-spacing: 0.04em; line-height: 1; }
  .chamber__desc { font-size: 14px; line-height: 1.55; color: var(--muted); }
  .chamber__enter { margin-top: 8px; font-size: 12px; }
  .facility__divider { display: flex; align-items: center; gap: 16px; margin: 56px 0 20px; font-size: 11px; letter-spacing: 0.22em; color: var(--steel); }
  .facility__divider .line { flex: 1; height: 1px; background: var(--line); }
  .sealed {
    display: flex; flex-direction: column; gap: 14px; padding: 24px; border: 1px dashed rgba(113, 128, 140, 0.3);
    background: repeating-linear-gradient(135deg, rgba(52, 56, 61, 0.12) 0 10px, transparent 10px 20px);
  }
  .sealed__top { display: flex; justify-content: space-between; font-size: 11px; color: var(--steel); }
  .sealed__name { font-family: var(--f-display); font-weight: 700; font-size: 26px; letter-spacing: 0.06em; color: var(--muted-2); }
  .sealed__desc { font-size: 13px; line-height: 1.5; color: #8b97a1; }
  .sealed__tag { font-size: 11px; color: var(--steel); }
  @media (max-width: 1100px) { .facility__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .facility { padding-top: 72px; padding-bottom: 64px; }
    .facility__grid { grid-template-columns: 1fr; gap: 12px; }
    .chamber { min-height: 0; gap: 18px; padding: 22px; }
    .chamber__num { position: absolute !important; right: 18px; top: 34px; font-size: 84px; }
    .sealed { padding: 18px; }
  }
</style>
