---
import { site, type Lang } from '../../data/site';
import { ui } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].home;
const v = site.latestVideo;
const videoUrl = v ? `https://www.youtube.com/watch?v=${v.id}` : site.youtube;
const date = v ? new Date(v.date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { year: 'numeric', month: 'short', day: '2-digit' }) : null;
---
<section class="wrap last" aria-labelledby="last-title">
  <div class="last__card reveal">
    <div class="last__media" data-yt={v?.id}>
      <span class="last__frame" aria-hidden="true"></span>
      {v ? (
        <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
      ) : (
        <span class="last__thumb mono">{t.thumb}</span>
      )}
      <a href={videoUrl} target="_blank" rel="noopener" class="last__play" aria-label={t.playAria} data-cursor="PLAY">
        <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true" fill="#FF3737"><path d="M8 5 L21 13 L8 21 Z"></path></svg>
      </a>
    </div>
    <div class="last__body">
      <p class="kicker">{t.lastK} · {date ?? (lang === 'es' ? '[FECHA]' : '[DATE]')}</p>
      <h2 id="last-title">{v ? v.title[lang] : t.lastTitle}</h2>
      <p class="muted">{v ? v.description[lang] : t.lastDesc}</p>
      <a href={site.youtube} class="btn btn--ghost" target="_blank" rel="me noopener">{t.channel}</a>
    </div>
  </div>
</section>

<style>
  .last { padding-bottom: 120px; }
  .last__card { display: flex; flex-wrap: wrap; border: 1px solid var(--line); background: var(--panel); }
  .last__media {
    flex: 1 1 560px; min-height: 340px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse at 40% 50%, #2a0a0d, #0a0a0b 70%); display: flex; align-items: center; justify-content: center;
  }
  .last__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; filter: grayscale(0.4); }
  .last__frame { position: absolute; inset: 16px; border: 1px solid rgba(113, 128, 140, 0.18); z-index: 1; }
  .last__thumb { position: absolute; left: 32px; top: 30px; font-size: 11px; color: var(--steel); }
  .last__play {
    position: relative; z-index: 2; width: 88px; height: 88px; border-radius: 50%; border: 1px solid var(--red); display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 60px rgba(255, 55, 55, 0.3); transition: transform 0.3s var(--ease), box-shadow 0.3s, background 0.3s;
  }
  .last__play:hover { transform: scale(1.08); box-shadow: 0 0 90px rgba(255, 55, 55, 0.5); background: rgba(255, 55, 55, 0.08); }
  .last__body { flex: 1 1 420px; padding: 48px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 18px; }
  .last__body h2 { font-size: clamp(36px, 4vw, 48px); font-weight: 700; line-height: 1; }
  .last__body p.muted { font-size: 15px; line-height: 1.65; }
  @media (max-width: 640px) {
    .last { padding-bottom: 72px; }
    .last__media { flex-basis: 100%; min-height: 220px; }
    .last__body { padding: 24px; }
  }
</style>
