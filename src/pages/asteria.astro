---
// Asteria: rincón celestial escondido. No aparece en el navbar, el mapa ni el sitemap;
// sólo se llega desde la fila "ASTERIA" del panel del Hero. Las frases viven en src/data/asteria.json.
// Estilo: el diseño "Asteria" del canvas (blanco perla → niebla azul, órbitas doradas, Cormorant fina).
import data from '../data/asteria.json';
import { href, asset } from '../i18n/paths';

const frases = data.frases.map((f) => f.trim()).filter(Boolean);

// Estrellas y destellos con posiciones pseudoaleatorias fijas (iguales en cada visita)
const r = (i: number, k: number) => (((Math.sin(i * 12.9898 + k * 78.233) * 43758.5453) % 1) + 1) % 1;
const stars = Array.from({ length: 52 }, (_, i) => ({
  x: (r(i, 1) * 100).toFixed(1), y: (r(i, 2) * 100).toFixed(1), size: (1.5 + r(i, 3) * 2.5).toFixed(1),
  c: r(i, 4) > 0.6 ? '#c9a96e' : '#9aa6c4', d: (2.5 + r(i, 5) * 4).toFixed(1), o: (r(i, 6) * 6).toFixed(1),
}));
const sparkles = Array.from({ length: 9 }, (_, i) => ({
  x: (6 + r(i, 7) * 88).toFixed(1), y: (8 + r(i, 8) * 84).toFixed(1), size: Math.round(10 + r(i, 9) * 14),
  d: (3 + r(i, 10) * 3).toFixed(1), o: (r(i, 11) * 4).toFixed(1),
}));
// Destello de cuatro puntas
const STAR = 'M10 0 C 10.8 6.5, 13.5 9.2, 20 10 C 13.5 10.8, 10.8 13.5, 10 20 C 9.2 13.5, 6.5 10.8, 0 10 C 6.5 9.2, 9.2 6.5, 10 0 Z';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Asteria</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f7f8fc" />
  <meta name="color-scheme" content="light" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@400;500&display=swap" />
  <script is:inline>try{if(localStorage.getItem('mz-motion')==='full')document.documentElement.dataset.motion='full';}catch(e){}</script>
</head>
<body>
  <main class="sky" data-sky data-frases={JSON.stringify(frases)}>
    <!-- bruma dorada -->
    <div class="sky__haze" aria-hidden="true"></div>

    <!-- órbitas -->
    <div class="sky__orbits" data-orbits aria-hidden="true">
      <span class="orbit orbit--1"></span>
      <span class="orbit orbit--2"></span>
      <span class="orbit orbit--3"></span>
      <span class="orbit__spin"><span class="orbit__dot"></span></span>
    </div>

    <!-- estrellas -->
    <div class="sky__stars" aria-hidden="true">
      {stars.map((s) => (
        <span class="star" style={`left:${s.x}%;top:${s.y}%;width:${s.size}px;height:${s.size}px;background:${s.c};animation-duration:${s.d}s;animation-delay:-${s.o}s`}></span>
      ))}
      {sparkles.map((k) => (
        <svg class="star" width={k.size} height={k.size} viewBox="0 0 20 20" style={`left:${k.x}%;top:${k.y}%;animation-duration:${k.d}s;animation-delay:-${k.o}s`}><path d={STAR} fill="#c9a96e" /></svg>
      ))}
    </div>

    <!-- regreso -->
    <header class="sky__top">
      <a class="sky__back" href={href('es')} data-back>
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 3 L5 8 L10 13"></path></svg>
        <span>Volver a la oscuridad</span>
      </a>
    </header>

    <!-- frases flotantes -->
    <div class="sky__words" data-words aria-hidden="true"></div>

    <!-- centro -->
    <div class="sky__center" data-center>
      <svg class="center__star" width="34" height="34" viewBox="0 0 20 20" aria-hidden="true"><path d={STAR} fill="#c9a96e" /></svg>
      <h1 class="center__name">Asteria</h1>
      <p class="center__sub" data-sub>aún desciende de las estrellas… pronto brillará con toda su luz</p>
    </div>

    <p class="sky__hint" aria-hidden="true"><span class="hint--fine">PASA EL CURSOR SOBRE LAS PALABRAS</span><span class="hint--touch">TOCA LAS PALABRAS</span></p>

    <!-- Para lectores de pantalla: todas las frases, en orden -->
    <ul class="sr-only">{frases.map((f) => <li>{f}</li>)}</ul>

    <!-- de la oscuridad a la luz -->
    <div class="sky__curtain" aria-hidden="true"></div>

    <!-- regreso a la oscuridad: la luz se corrompe -->
    <div class="sky__fall" aria-hidden="true">
      <div class="fall__tint"></div>
      <div class="fall__dark"></div>
      <div class="fall__scan"></div>
      <i class="tear"></i><i class="tear"></i><i class="tear"></i><i class="tear"></i><i class="tear"></i><i class="tear"></i>
      <div class="fall__line"></div>
    </div>
  </main>

  <script>
    import { reducedMotion } from '../scripts/motion';

    const sky = document.querySelector<HTMLElement>('[data-sky]')!;
    const layer = sky.querySelector<HTMLElement>('[data-words]')!;
    const center = sky.querySelector<HTMLElement>('[data-center]')!;
    const orbits = sky.querySelector<HTMLElement>('[data-orbits]')!;
    const frases: string[] = JSON.parse(sky.dataset.frases || '[]');
    const reduced = reducedMotion();
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    requestAnimationFrame(() => requestAnimationFrame(() => sky.classList.add('is-lit')));

    /* ---------- Frases: todas salen, en desorden, sin repetirse hasta completar la ronda ---------- */
    let deck: string[] = [];
    let last = '';
    const next = () => {
      if (!deck.length) {
        deck = [...frases];
        for (let i = deck.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [deck[i], deck[j]] = [deck[j], deck[i]]; }
        if (deck.length > 1 && deck[deck.length - 1] === last) deck.unshift(deck.pop()!); // no repetir la última al cambiar de ronda
      }
      return (last = deck.pop()!);
    };

    type Box = { x: number; y: number; w: number; h: number; el: HTMLElement };
    const live: Box[] = [];
    const overlaps = (a: Omit<Box, 'el'>, pad: number) =>
      live.some((b) => a.x < b.x + b.w + pad && a.x + a.w + pad > b.x && a.y < b.y + b.h + pad && a.y + a.h + pad > b.y);

    const maxLive = () => (innerWidth < 640 ? 6 : innerWidth < 1100 ? 9 : 12);
    // los tres tonos del diseño: grande e itálica, media recta, pequeña e itálica
    const tiers = [
      { cls: 't1', k: 1 },
      { cls: 't2', k: 0.74 },
      { cls: 't3', k: 0.56 },
    ];

    function spawn(at?: { x: number; y: number }) {
      if (!frases.length || live.length >= maxLive()) return;
      const text = next();
      const tier = tiers[Math.floor(Math.random() * tiers.length)];
      const el = document.createElement('span');
      el.className = `word ${tier.cls}`;
      const inner = document.createElement('span');
      inner.className = 'word__in';
      inner.textContent = text;
      el.appendChild(inner);

      // las frases largas, un poco más pequeñas para que respiren
      const vw = Math.min(innerWidth, 1600);
      const len = text.length;
      const fit = len <= 10 ? 1 : len <= 20 ? 0.82 : 0.66;
      const px = Math.max(16, (innerWidth < 640 ? 34 : vw * 0.031) * tier.k * fit);
      el.style.fontSize = `${px.toFixed(1)}px`;
      el.style.setProperty('--life', `${rand(8, 11).toFixed(2)}s`);
      el.style.setProperty('--float', `${rand(5, 9).toFixed(1)}s`);
      el.style.visibility = 'hidden';
      layer.appendChild(el);

      const w = el.offsetWidth, h = el.offsetHeight;
      const W = layer.clientWidth, H = layer.clientHeight;
      const m = Math.min(28, W * 0.05);
      const c = center.getBoundingClientRect();
      const cBox = { x: c.left - 24, y: c.top - 16, w: c.width + 48, h: c.height + 32 };
      const hitsCenter = (b: { x: number; y: number; w: number; h: number }) =>
        b.x < cBox.x + cBox.w && b.x + b.w > cBox.x && b.y < cBox.y + cBox.h && b.y + b.h > cBox.y;
      const top = innerWidth < 640 ? 84 : 100, bottom = 64; // libres el botón de arriba y la pista de abajo

      let spot: { x: number; y: number } | null = null;
      for (let i = 0; i < 50 && !spot; i++) {
        let x = rand(m, Math.max(m, W - w - m)), y = rand(top, Math.max(top, H - h - bottom));
        if (at && i < 14) {
          x = Math.min(Math.max(m, at.x - w / 2 + rand(-50, 50)), W - w - m);
          y = Math.min(Math.max(top, at.y - h / 2 + rand(-40, 40)), H - h - bottom);
        }
        const b = { x, y, w, h };
        if (!overlaps(b, 22) && !hitsCenter(b)) spot = { x, y };
      }
      if (!spot) { el.remove(); return; }

      el.style.left = `${spot.x}px`;
      el.style.top = `${spot.y}px`;
      el.style.visibility = '';
      const box: Box = { ...spot, w, h, el };
      live.push(box);
      el.addEventListener('animationend', (e) => {
        if (e.target !== el) return; // sólo el ciclo de vida, no la flotación interna
        el.remove();
        live.splice(live.indexOf(box), 1);
      });
    }

    /* ---------- Volver a la oscuridad: la luz se corrompe, se tiñe de rojo y se apaga ---------- */
    let falling = false;
    const GLYPHS = '█▓▒░#%&@$¿?!/|<>[]{}*¤ж';
    const corrupt = (text: string, p: number) =>
      [...text].map((ch) => (ch !== ' ' && Math.random() < p ? GLYPHS[Math.floor(Math.random() * GLYPHS.length)] : ch)).join('');
    const tears = Array.from(sky.querySelectorAll<HTMLElement>('.tear'));

    sky.querySelector<HTMLAnchorElement>('[data-back]')!.addEventListener('click', (e) => {
      if (reduced || falling || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      falling = true;
      const dest = (e.currentTarget as HTMLAnchorElement).href;
      const name = center.querySelector<HTMLElement>('.center__name')!;
      const sub = center.querySelector<HTMLElement>('[data-sub]')!;
      const nameSrc = name.textContent || '', subDark = 'donde todo vuelve a la oscuridad';
      const words = Array.from(layer.querySelectorAll<HTMLElement>('.word__in'));
      words.forEach((w) => { w.dataset.src = w.textContent || ''; });
      sky.classList.add('is-falling');
      const tint = sky.querySelector<HTMLElement>('.fall__tint')!;
      const dark = sky.querySelector<HTMLElement>('.fall__dark')!;
      const scan = sky.querySelector<HTMLElement>('.fall__scan')!;
      const shaken = [layer, center];
      let subText = sub.textContent || '';

      const DUR = 2100;
      const t0 = performance.now();
      let lastBurst = 0;
      const frame = (now: number) => {
        const t = Math.min(1, (now - t0) / DUR);
        const L = t * t * (3 - 2 * t); // arranca suave y se precipita
        // sólo opacidades: baratas para la GPU
        tint.style.opacity = Math.min(1, L * 1.4).toFixed(3);
        dark.style.opacity = Math.min(1, L * 1.05).toFixed(3);
        scan.style.opacity = (L * 0.8).toFixed(3);

        // ráfagas cada vez más seguidas: rasgaduras, letras corruptas, a veces espejo
        if (now - lastBurst > 260 - L * 200) {
          lastBurst = now;
          const p = 0.08 + L * 0.6;
          name.textContent = corrupt(nameSrc, p * 0.8);
          words.forEach((w) => { w.textContent = corrupt(w.dataset.src || '', p); });
          if (L > 0.35) subText = subDark;
          sub.textContent = corrupt(subText, p * 0.7);
          const H = innerHeight;
          tears.forEach((tr) => {
            const on = Math.random() < 0.3 + L * 0.6;
            tr.style.opacity = on ? '1' : '0';
            // posición y grosor con transform (mover top/height obligaba a recalcular el layout)
            tr.style.transform = `translate(${(rand(-40, 40) * (0.3 + L)).toFixed(1)}px, ${(rand(0, H)).toFixed(0)}px) scaleY(${(rand(0.5, 1.5 + L * 10)).toFixed(2)})`;
          });
          const tx = `translateX(${(rand(-12, 12) * L).toFixed(1)}px)`;
          shaken.forEach((el) => { el.style.transform = tx; });
          sky.classList.add('is-split');
          sky.classList.toggle('is-mirror', L > 0.55 && Math.random() < 0.25);
          setTimeout(() => {
            sky.classList.remove('is-split', 'is-mirror');
            shaken.forEach((el) => { el.style.transform = ''; });
            tears.forEach((tr) => { tr.style.opacity = '0'; });
            if (t < 0.85) { name.textContent = nameSrc; words.forEach((w) => { w.textContent = w.dataset.src || ''; }); }
          }, rand(50, 90 + L * 80));
        }
        if (t < 1) requestAnimationFrame(frame);
        else { sky.classList.add('is-gone'); setTimeout(() => { location.href = dest; }, 320); }
      };
      requestAnimationFrame(frame);
    });

    if (frases.length) {
      for (let i = 0; i < 5; i++) setTimeout(() => spawn(), 1800 + i * 500);
      const tick = () => { if (falling) return; spawn(); setTimeout(tick, rand(reduced ? 1600 : 1000, reduced ? 2600 : 1700)); };
      setTimeout(tick, 4500);
    }

    /* ---------- Toque: unos destellos dorados y una frase que nace ahí ---------- */
    const STAR = 'M10 0 C 10.8 6.5, 13.5 9.2, 20 10 C 13.5 10.8, 10.8 13.5, 10 20 C 9.2 13.5, 6.5 10.8, 0 10 C 6.5 9.2, 9.2 6.5, 10 0 Z';
    const glint = (x: number, y: number, n: number, spread: number) => {
      if (reduced) return;
      for (let i = 0; i < n; i++) {
        const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        s.setAttribute('viewBox', '0 0 20 20');
        s.setAttribute('class', 'glint');
        s.innerHTML = `<path d="${STAR}" fill="${Math.random() < 0.7 ? '#c9a96e' : '#9aa6c4'}"/>`;
        const a = rand(0, Math.PI * 2), d = rand(spread * 0.3, spread);
        const sz = rand(6, 14);
        s.style.cssText = `left:${x}px;top:${y}px;width:${sz}px;height:${sz}px;--dx:${Math.cos(a) * d}px;--dy:${Math.sin(a) * d - 16}px`;
        sky.appendChild(s);
        s.addEventListener('animationend', () => s.remove(), { once: true });
      }
    };
    sky.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) return;
      glint(e.clientX, e.clientY, 9, 70);
      const rc = layer.getBoundingClientRect();
      spawn({ x: e.clientX - rc.left, y: e.clientY - rc.top });
    });

    /* ---------- Parallax suave con el cursor + estela tenue ---------- */
    let lastTrail = 0;
    sky.addEventListener('pointermove', (e) => {
      if (reduced || e.pointerType !== 'mouse') return;
      const dx = e.clientX / innerWidth * 2 - 1, dy = e.clientY / innerHeight * 2 - 1;
      layer.style.translate = `${(dx * -18).toFixed(1)}px ${(dy * -12).toFixed(1)}px`;
      orbits.style.translate = `${(dx * -8).toFixed(1)}px ${(dy * -5).toFixed(1)}px`;
      const now = performance.now();
      if (now - lastTrail > 90) { lastTrail = now; glint(e.clientX, e.clientY, 1, 24); }
    });
  </script>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body { background: #ffffff; color: #2b2f3a; overflow: hidden; font-family: 'Cormorant Garamond', Georgia, serif; -webkit-font-smoothing: antialiased; }
    ::selection { background: #f1e4c4; color: #2b2f3a; }
    .sr-only { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  </style>

  <style>
    .sky {
      position: relative; height: 100vh; height: 100dvh; overflow: hidden; isolation: isolate;
      background: radial-gradient(ellipse 60% 55% at 50% 48%, #ffffff 0%, #f7f8fc 45%, #e8edf6 100%);
    }

    .sky__haze {
      position: absolute; left: 50%; top: 48%; width: min(900px, 140vw); height: min(600px, 90vh); translate: -50% -50%; pointer-events: none;
      background: radial-gradient(ellipse, rgba(240, 220, 170, 0.35) 0%, rgba(240, 220, 170, 0) 65%);
      animation: breath 8s ease-in-out infinite;
    }

    /* Órbitas elípticas: escalan con la pantalla */
    .sky__orbits { position: absolute; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none; transition: translate 0.6s ease-out; --u: min(1px, 0.09vw); }
    .orbit { position: absolute; left: 0; top: 0; border-radius: 50%; translate: -50% -50%; }
    .orbit--1 { width: calc(520 * var(--u)); height: calc(300 * var(--u)); border: 1px solid rgba(176, 138, 62, 0.22); }
    .orbit--2 { width: calc(820 * var(--u)); height: calc(480 * var(--u)); border: 1px solid rgba(113, 128, 160, 0.16); }
    .orbit--3 { width: calc(1140 * var(--u)); height: calc(680 * var(--u)); border: 1px dashed rgba(113, 128, 160, 0.14); }
    .orbit__spin { position: absolute; left: 0; top: 0; width: calc(1140 * var(--u)); height: calc(1140 * var(--u)); translate: -50% -50%; animation: spin 90s linear infinite; }
    .orbit__dot { position: absolute; left: 50%; top: 0; width: 6px; height: 6px; border-radius: 50%; background: #c9a96e; box-shadow: 0 0 12px #e9d4a0; }
    @media (max-width: 640px) {
      /* en vertical, las órbitas se estiran a lo alto como en el diseño móvil */
      .orbit--1 { width: 250px; height: 250px; }
      .orbit--2 { width: 360px; height: 470px; }
      .orbit--3 { width: 470px; height: 680px; }
      .orbit__spin { width: 680px; height: 680px; }
    }

    .sky__stars { position: absolute; inset: 0; pointer-events: none; }
    .star { position: absolute; border-radius: 50%; animation: twinkle 4s ease-in-out infinite; }
    svg.star { border-radius: 0; }

    .sky__top { position: absolute; top: 0; left: 0; right: 0; z-index: 5; display: flex; padding: 28px 48px; font-family: Inter, sans-serif; }
    .sky__back {
      display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 20px; border-radius: 999px;
      border: 1px solid rgba(113, 128, 160, 0.3); background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(8px);
      font-size: 13px; letter-spacing: 0.06em; color: #4a4f66; text-decoration: none; transition: background 0.3s, border-color 0.3s;
    }
    .sky__back:hover, .sky__back:focus-visible { background: #fff; border-color: #c9a96e; }

    .sky__words { position: absolute; inset: 0; z-index: 2; pointer-events: none; transition: translate 0.8s ease-out; }

    /* Cada frase: nace de la luz, flota y vuelve a la luz */
    .sky :global(.word) { position: absolute; white-space: nowrap; line-height: 1.15; animation: word var(--life) ease-in-out both; }
    .sky :global(.word__in) {
      display: inline-block; pointer-events: auto; cursor: default; letter-spacing: 0.02em;
      animation: float var(--float) ease-in-out infinite;
      transition: color 0.5s, text-shadow 0.5s, scale 0.5s;
    }
    .sky :global(.word.t1) { font-style: italic; font-weight: 400; color: #3d4157; }
    .sky :global(.word.t2) { font-weight: 400; color: #55597a; }
    .sky :global(.word.t3) { font-style: italic; font-weight: 300; color: #7a7f99; }
    .sky :global(.word__in:hover), .sky :global(.word__in:active) { color: #b08a3e; text-shadow: 0 0 24px rgba(214, 180, 110, 0.65); scale: 1.08; }

    .sky :global(.glint) { position: absolute; z-index: 4; pointer-events: none; translate: -50% -50%; animation: glint 1.4s ease-out forwards; }

    /* Centro */
    .sky__center { position: absolute; left: 50%; top: 50%; z-index: 3; translate: -50% -50%; text-align: center; pointer-events: none; width: max-content; max-width: 100%; }
    .center__star { display: block; margin: 0 auto 10px; opacity: 0; transition: opacity 1.4s ease 1.1s; }
    .center__name {
      margin: 0; font-weight: 300; font-size: clamp(78px, 11.7vw, 168px); line-height: 0.9; letter-spacing: 0.06em; color: #2b2f3a;
      text-shadow: 0 0 60px rgba(255, 255, 255, 1), 0 0 30px rgba(240, 220, 170, 0.6);
      opacity: 0; transform: translateY(16px); transition: opacity 1.8s ease 0.8s, transform 1.8s cubic-bezier(.16, 1, .3, 1) 0.8s;
    }
    .center__sub {
      margin: 18px 0 0; font-style: italic; font-weight: 300; font-size: clamp(18px, 1.7vw, 24px); letter-spacing: 0.04em; color: #6b6f86;
      opacity: 0; transform: translateY(16px); transition: opacity 1.8s ease 1.3s, transform 1.8s cubic-bezier(.16, 1, .3, 1) 1.3s;
    }
    .sky.is-lit .center__star { opacity: 1; }
    .sky.is-lit .center__name, .sky.is-lit .center__sub { opacity: 1; transform: none; }

    .sky__hint { position: absolute; left: 0; right: 0; bottom: 32px; z-index: 3; margin: 0; text-align: center; font-family: Inter, sans-serif; font-size: 12px; letter-spacing: 0.2em; color: #7d8299; }
    .hint--touch { display: none; }
    @media (hover: none) { .hint--fine { display: none; } .hint--touch { display: inline; } }

    /* Llegada: se abre desde la luz blanca con que termina el cruce desde Martzian */
    .sky__curtain {
      position: absolute; inset: 0; z-index: 10; pointer-events: none;
      background: radial-gradient(circle at 50% 48%, #fff 0%, #fffdf7 50%, #f7f3e8 100%);
      transition: opacity 2.2s cubic-bezier(.65, 0, .35, 1) 0.25s;
    }
    .sky.is-lit .sky__curtain { opacity: 0; }

    /* ---------- Caída a la oscuridad ---------- */
    /* Capas encima que sólo cambian opacidad (el script las ajusta en cada fotograma): la GPU las
       mezcla sin repintar la página. Filtros y sombras animadas sobre todo hacían que fuera a tirones. */
    .sky__fall { position: absolute; inset: 0; z-index: 9; pointer-events: none; visibility: hidden; }
    .sky.is-falling .sky__fall { visibility: visible; }
    .sky.is-falling { cursor: progress; }
    .fall__dark, .fall__tint, .fall__scan { position: absolute; inset: 0; opacity: 0; will-change: opacity; }
    /* el oro se tiñe de rojo sangre */
    .fall__tint { background: #b3121e; mix-blend-mode: multiply; }
    /* y la luz se apaga */
    .fall__dark { background: radial-gradient(ellipse 70% 60% at 50% 48%, rgba(40, 6, 8, 0.55) 0%, #080808 75%); }
    .fall__scan { background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.35) 0 1px, transparent 1px 3px); }
    /* separación rojo/cian sólo durante las ráfagas (un valor fijo, no uno que cambie cada fotograma) */
    .sky.is-split .center__name, .sky.is-split :global(.word__in) { text-shadow: 4px 0 rgba(255, 30, 60, 0.75), -4px 0 rgba(0, 220, 255, 0.6); }
    .sky.is-falling .sky__words, .sky.is-falling .sky__center { will-change: transform; }
    .sky.is-mirror .sky__center { scale: -1 1; }
    /* rasgaduras: franjas en modo "diferencia" invierten lo que tienen debajo, sin backdrop-filter */
    .tear { position: absolute; left: -5%; right: -5%; top: 0; height: 4px; transform-origin: 50% 0; opacity: 0; background: #fff; mix-blend-mode: difference; will-change: transform, opacity; }
    .fall__line { position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: #ff3737; box-shadow: 0 0 18px #ff3737; scale: 0 1; opacity: 0; }
    .sky.is-gone .fall__dark { opacity: 1; background: #080808; }
    .sky.is-gone .fall__line { animation: line-off 0.32s ease-out forwards; }
    @keyframes line-off { 0% { opacity: 1; scale: 1 1; } 60% { opacity: 1; scale: 1 0.4; } 100% { opacity: 0; scale: 0 0.4; } }

    @media (max-width: 640px) {
      .sky__top { padding: 16px; }
      .sky__back { padding: 0 14px; font-size: 12px; }
      .center__star { width: 24px; height: 24px; margin-bottom: 6px; }
      .center__sub { margin-top: 10px; }
      .sky__hint { bottom: 28px; font-size: 11px; letter-spacing: 0.18em; }
    }

    @keyframes breath { 0%, 100% { opacity: 0.55; } 50% { opacity: 0.9; } }
    @keyframes spin { to { rotate: 360deg; } }
    @keyframes twinkle { 0%, 100% { opacity: 0.15; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1); } }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    @keyframes word {
      0%   { opacity: 0; filter: blur(8px); transform: translateY(18px); }
      18%  { opacity: 1; filter: blur(0); transform: none; }
      80%  { opacity: 1; filter: blur(0); transform: none; }
      100% { opacity: 0; filter: blur(6px); transform: translateY(-12px); }
    }
    @keyframes glint {
      0%   { opacity: 0; transform: translate(0, 0) scale(0.3) rotate(0deg); }
      25%  { opacity: 1; }
      100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(1) rotate(90deg); }
    }

    /* Menos movimiento (salvo que hayan activado FX): todo quieto, las frases sólo aparecen y se desvanecen */
    @media (prefers-reduced-motion: reduce) {
      :global(:root:not([data-motion='full'])) .sky__haze,
      :global(:root:not([data-motion='full'])) .orbit__spin,
      :global(:root:not([data-motion='full'])) .star,
      :global(:root:not([data-motion='full'])) .sky :global(.word__in) { animation: none; }
      :global(:root:not([data-motion='full'])) .sky :global(.word) { animation-name: word-calm; }
      :global(:root:not([data-motion='full'])) .center__star,
      :global(:root:not([data-motion='full'])) .center__name,
      :global(:root:not([data-motion='full'])) .center__sub,
      :global(:root:not([data-motion='full'])) .sky__curtain { transition: none; }
      :global(:root:not([data-motion='full'])) .star { opacity: 0.6; }
    }
    @keyframes word-calm { 0%, 100% { opacity: 0; } 15%, 82% { opacity: 1; } }
  </style>
</body>
</html>
