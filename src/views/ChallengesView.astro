---
import Base from '../layouts/Base.astro';
import ChamberHead from '../components/ChamberHead.astro';
import Dossier from '../components/challenges/Dossier.astro';
import HallOfFame from '../components/challenges/HallOfFame.astro';
import type { Lang } from '../data/site';
import { ui } from '../i18n/ui';
import { asset } from '../i18n/paths';
import data from '../data/challenges.json';
import type { Challenge } from '../components/challenges/types';

/** El Hall of Fame queda oculto hasta que haya ganadores reales. Ponlo en true para mostrarlo. */
const SHOW_HALL_OF_FAME = false;

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].challenges;
const challenges = data.challenges as Challenge[];
const anyPlaceholder = challenges.some((c) => c.placeholder);
// Expediente abierto por defecto: el último completado, o el primero
const initial = (challenges.find((c) => c.status === 'COMPLETED') ?? challenges[0])?.id;
const fmt = (c: Challenge) => c.date
  ? new Date(c.date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' })
  : c.status === 'UPCOMING' ? t.upcomingDate : c.status === 'ACTIVE' ? t.activeDate : t.unknownDate;

const jsonLd = [{
  '@type': 'CollectionPage', name: t.title, description: t.description,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: challenges.filter((c) => !c.placeholder).map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title[lang] })),
  },
}];
---
<Base lang={lang} slug="challenges" title={t.title} description={t.description} crumbName="Challenges" showChamberStatus="02" jsonLd={jsonLd}>
  <ChamberHead lang={lang} crumb={t.crumb}>
    <h1 slot="title">IDV CHALLENGES</h1>
    <div slot="lede" class="ch-lede">
      <p class="chamber-head__lede">{t.lede}</p>
      {anyPlaceholder && (
        <p class="notice">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 1.5 L13 12.5 H1 Z M7 5.5 V8.5 M7 10.2 V10.6"></path></svg>{t.sample}
        </p>
      )}
    </div>
  </ChamberHead>

  <section class="archive wrap" data-archive data-initial={initial}>
    <div class="archive__list">
      <div class="archive__head mono">
        <span>{t.archiveK}</span>
        <span class="archive__count">{String(challenges.length).padStart(2, '0')} {t.files}</span>
        <span class="archive__tap">{t.tapHint}</span>
      </div>
      <ul class="archive__grid">
        {challenges.map((c) => (
          <li>
            <button type="button" class="card" data-card={c.id} data-status={c.status} aria-controls={`dossier-${c.id}`} aria-pressed={c.id === initial ? 'true' : 'false'} data-cursor="OPEN">
              <span class="card__thumb" data-status={c.status}>
                {c.thumbnail ? <img src={asset(c.thumbnail)} alt="" loading="lazy" /> : <span class="card__ph mono">{t.thumb}</span>}
                <span class="card__num" aria-hidden="true">{c.number}</span>
                <span class="status-tag" data-status={c.status}><span></span>{t.status[c.status]}</span>
              </span>
              <span class="card__body">
                <span class="card__meta mono"><span>{c.id}</span><span class="card__date">{fmt(c)}</span></span>
                <span class="card__title">{c.title[lang]}</span>
                <span class="card__cta mono" aria-hidden="true">{t.cta[c.status]}</span>
              </span>
              <span class="sr-only">{t.openAria} {c.title[lang]}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <aside class="archive__panel" aria-label={t.dossierAria} data-dossiers tabindex="-1">
      {challenges.map((c) => <Dossier lang={lang} c={c} hidden={c.id !== initial} />)}
    </aside>
  </section>

  {SHOW_HALL_OF_FAME && <HallOfFame lang={lang} />}
</Base>

<style>
  .ch-lede { display: flex; flex-direction: column; align-items: flex-end; gap: 18px; max-width: 460px; }
  .ch-lede .chamber-head__lede { margin: 0; text-align: right; }

  .archive { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; padding-top: 40px; padding-bottom: 96px; }
  .archive__list { flex: 1 1 560px; min-width: 0; }
  .archive__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; font-size: 11px; letter-spacing: 0.16em; color: var(--steel); }
  .archive__tap { display: none; }
  .archive__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }

  .card {
    --bd: var(--line);
    width: 100%; height: 100%; text-align: left; padding: 0; background: var(--panel); border: 1px solid var(--bd); color: var(--white);
    cursor: pointer; display: flex; flex-direction: column; font-family: var(--f-body);
    transition: border-color 0.3s, transform 0.3s var(--ease), box-shadow 0.3s;
    animation: card-in 0.5s var(--ease) both;
  }
  .card:hover { --bd: var(--red); transform: translateY(-3px); box-shadow: 0 18px 50px rgba(165, 31, 36, 0.18); }
  .card[aria-pressed='true'] { --bd: var(--blood); }
  @keyframes card-in { from { opacity: 0; transform: translateY(10px); } }
  .card__thumb { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: radial-gradient(circle at 70% 40%, var(--glow), #0a0a0b 65%); }
  .card__thumb[data-status='COMPLETED'] { --glow: rgba(52, 56, 61, 0.6); }
  .card__thumb[data-status='ACTIVE'] { --glow: rgba(165, 31, 36, 0.55); }
  .card__thumb[data-status='UPCOMING'] { --glow: rgba(113, 128, 140, 0.25); }
  .card__thumb::before { content: ''; position: absolute; inset: 0; z-index: 1; background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 4px), linear-gradient(90deg, transparent calc(50% - 0.5px), rgba(113, 128, 140, 0.2) 50%, transparent calc(50% + 0.5px)), linear-gradient(0deg, transparent calc(50% - 0.5px), rgba(113, 128, 140, 0.2) 50%, transparent calc(50% + 0.5px)); }
  .card__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .card__ph { position: absolute; left: 18px; top: 16px; z-index: 2; font-size: 11px; color: var(--muted); }
  .card__num { position: absolute; left: 18px; bottom: 4px; z-index: 2; font-family: var(--f-display); font-weight: 800; font-size: 88px; line-height: 1; color: rgba(215, 215, 215, 0.08); }
  .card__thumb .status-tag { position: absolute; right: 14px; top: 14px; z-index: 2; }
  .card__body { display: flex; flex-direction: column; gap: 8px; padding: 18px 18px 20px; }
  .card__meta { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; letter-spacing: 0.14em; color: var(--steel); }
  .card__title { font-family: var(--f-display); font-weight: 700; font-size: 28px; line-height: 1; letter-spacing: 0.03em; }
  .card__cta { margin-top: 4px; font-size: 11px; letter-spacing: 0.14em; color: var(--white); transition: color 0.3s; }
  .card[aria-pressed='true'] .card__cta, .card:hover .card__cta { color: var(--red); }

  .archive__panel {
    flex: 1 1 560px; min-width: 0; position: sticky; top: 24px; scroll-margin-top: 16px;
    border: 1px solid var(--blood); background: linear-gradient(180deg, var(--black-red) 0%, #0b0b0c 30%);
  }
  .archive__panel:focus { outline: none; }

  @media (max-width: 900px) {
    .ch-lede { align-items: flex-start; }
    .ch-lede .chamber-head__lede { text-align: left; }
  }
  /* Móvil: 2 por fila con miniaturas cuadradas; los resultados quedan debajo */
  @media (max-width: 860px) {
    .archive { flex-direction: column; align-items: stretch; gap: 16px; padding-top: 20px; padding-bottom: 32px; }
    .archive__list, .archive__panel { flex: none; }
    .archive__panel { position: static; }
    .archive__head { margin: 0 2px 12px; font-size: 10px; letter-spacing: 0.14em; }
    .archive__count { display: none; }
    .archive__tap { display: inline; }
    .archive__grid { gap: 10px; }
    .card__thumb { aspect-ratio: 1 / 1; }
    .card__thumb::before { background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 4px); }
    .card__ph { left: 10px; top: 10px; font-size: 9px; letter-spacing: 0.12em; }
    .card__num { left: 10px; bottom: 0; font-size: 64px; }
    .card__thumb .status-tag { top: auto; right: 8px; bottom: 8px; gap: 5px; padding: 4px 7px; font-size: 8px; letter-spacing: 0.12em; }
    .card__thumb .status-tag span { width: 5px; height: 5px; }
    .card__body { gap: 4px; padding: 10px 10px 12px; }
    .card__meta { font-size: 9px; letter-spacing: 0.12em; }
    .card__date, .card__cta { display: none; }
    .card__title { font-size: 19px; line-height: 1.02; letter-spacing: 0.02em; }
  }
</style>

<style is:global>
  .status-tag {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; background: rgba(8, 8, 8, 0.8);
    border: 1px solid var(--st); color: var(--st); font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.18em;
  }
  .status-tag span { width: 6px; height: 6px; border-radius: 50%; background: var(--st); }
  .status-tag[data-status='COMPLETED'] { --st: #9aa6b0; }
  .status-tag[data-status='ACTIVE'] { --st: #FF3737; }
  .status-tag[data-status='ACTIVE'] span { animation: mz-pulse 1.6s infinite; }
  .status-tag[data-status='UPCOMING'] { --st: #D7D7D7; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-card]')];
    const panel = root.querySelector<HTMLElement>('[data-dossiers]')!;
    const mobile = matchMedia('(max-width: 860px)');

    const setOpen = (btn: HTMLButtonElement, on: boolean) => {
      btn.setAttribute('aria-expanded', String(on));
      const table = document.getElementById(btn.getAttribute('aria-controls')!);
      if (table) table.hidden = !on;
    };

    const open = (id: string, fromUser = true) => {
      const target = panel.querySelector<HTMLElement>(`[data-dossier="${id}"]`);
      if (!target) return;
      panel.querySelectorAll<HTMLElement>('[data-dossier]').forEach((d) => (d.hidden = d !== target));
      cards.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.card === id)));
      target.querySelectorAll<HTMLButtonElement>('[data-collapse]').forEach((b) => setOpen(b, false));
      target.classList.remove('is-booting'); void target.offsetWidth; target.classList.add('is-booting');
      if (fromUser) history.replaceState(null, '', '#' + id);
      // En móvil el panel está debajo de la grilla: llévalo a la vista
      if (mobile.matches && fromUser) {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        panel.focus({ preventScroll: true });
      }
    };

    cards.forEach((c) => c.addEventListener('click', () => open(c.dataset.card!)));

    // Desplegables del expediente (reglas y participantes)
    panel.querySelectorAll<HTMLButtonElement>('[data-collapse]').forEach((btn) => {
      btn.addEventListener('click', () => setOpen(btn, btn.getAttribute('aria-expanded') !== 'true'));
    });

    const hash = decodeURIComponent(location.hash.slice(1));
    if (hash && cards.some((c) => c.dataset.card === hash)) open(hash, false);
  }
</script>
