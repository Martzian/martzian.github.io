---
import Base from '../layouts/Base.astro';
import ChamberHead from '../components/ChamberHead.astro';
import Dossier from '../components/challenges/Dossier.astro';
import HallOfFame from '../components/challenges/HallOfFame.astro';
import type { Lang } from '../data/site';
import { ui } from '../i18n/ui';
import { asset } from '../i18n/paths';
import data from '../data/challenges.json';
import type { Challenge } from '../components/challenges/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].challenges;
const challenges = data.challenges as Challenge[];
const anyPlaceholder = challenges.some((c) => c.placeholder);
const STATUSES = ['ALL', 'ACTIVE', 'UPCOMING', 'COMPLETED'] as const;
const count = (k: string) => (k === 'ALL' ? challenges.length : challenges.filter((c) => c.status === k).length);
// Expediente abierto por defecto: el último completado, o el primero
const initial = (challenges.find((c) => c.status === 'COMPLETED') ?? challenges[0])?.id;
const fmt = (d: string | null) => d ? new Date(d).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: '2-digit', year: 'numeric' }) : t.unknownDate;

const jsonLd = [{
  '@type': 'CollectionPage', name: t.title, description: t.description,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: challenges.filter((c) => !c.placeholder).map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title[lang] })),
  },
}];
---
<Base lang={lang} slug="challenges" title={t.title} description={t.description} crumbName="Challenges" showChamberStatus="02" jsonLd={jsonLd}>
  <ChamberHead lang={lang} crumb={t.crumb}>
    <h1 slot="title">CHALLENGES</h1>
    <p slot="lede" class="chamber-head__lede">{t.lede}</p>
    {anyPlaceholder && (
      <p class="notice" style="margin-top:28px">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 1.5 L13 12.5 H1 Z M7 5.5 V8.5 M7 10.2 V10.6"></path></svg>{t.sample}
      </p>
    )}
  </ChamberHead>

  <section class="archive wrap" data-archive data-initial={initial}>
    <div class="archive__filters" role="group" aria-label={t.filterAria}>
      {STATUSES.map((k) => (
        <button type="button" class="chip" data-filter={k} aria-pressed={k === 'ALL' ? 'true' : 'false'}>
          {t.filters[k]}<span class="chip__count">{String(count(k)).padStart(2, '0')}</span>
        </button>
      ))}
      <span class="archive__shown mono"><span data-shown>{String(challenges.length).padStart(2, '0')}</span> {t.files}</span>
    </div>

    <div class="archive__layout">
      <ul class="archive__grid">
        {challenges.map((c) => (
          <li data-status={c.status} data-card-wrap>
            <button type="button" class="card" data-card={c.id} aria-controls={`dossier-${c.id}`} aria-expanded={c.id === initial ? 'true' : 'false'} data-cursor="OPEN">
              <span class="card__thumb" data-status={c.status}>
                {c.thumbnail ? <img src={asset(c.thumbnail)} alt="" loading="lazy" /> : <span class="card__ph mono">[THUMBNAIL]</span>}
                <span class="card__num" aria-hidden="true">{c.number}</span>
                <span class="status-tag" data-status={c.status}><span></span>{t.status[c.status]}</span>
              </span>
              <span class="card__body">
                <span class="card__meta mono"><span>{c.id}</span><span>{fmt(c.date)}</span></span>
                <span class="card__title">{c.title[lang]}</span>
                <span class="card__summary">{c.summary[lang]}</span>
                <span class="card__stats mono">
                  <span>{t.participants} · <b>{c.participants ?? t.unknown}</b></span>
                  <span>{t.winners} · <b>{c.winners.length || '—'}</b></span>
                </span>
              </span>
              <span class="sr-only">{t.openAria}</span>
            </button>
          </li>
        ))}
      </ul>

      <aside class="archive__dossiers" aria-label={t.dossierAria} data-dossiers>
        <button type="button" class="dossier-close" data-dossier-close aria-label={ui[lang].close}>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4 L14 14 M14 4 L4 14"></path></svg>
        </button>
        {challenges.map((c) => <Dossier lang={lang} c={c} hidden={c.id !== initial} />)}
      </aside>
    </div>
  </section>

  <HallOfFame lang={lang} />
</Base>

<style>
  .archive { padding-bottom: 80px; }
  .archive__filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; padding: 24px 0; border-block: 1px solid var(--line-soft); margin-bottom: 32px; }
  .archive__filters .chip { font-size: 12px; letter-spacing: 0.16em; padding: 0 20px; }
  .archive__shown { margin-left: auto; font-size: 11px; color: var(--steel); }
  .archive__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 440px); gap: 32px; align-items: start; }
  .archive__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .archive__grid li[hidden] { display: none; }
  .card {
    width: 100%; height: 100%; text-align: left; padding: 0; background: var(--panel); border: 1px solid var(--line); color: var(--white);
    cursor: pointer; display: flex; flex-direction: column; transition: border-color 0.3s, transform 0.3s var(--ease), box-shadow 0.3s;
    animation: card-in 0.5s var(--ease) both;
  }
  .card:hover { border-color: var(--red); transform: translateY(-3px); box-shadow: 0 18px 50px rgba(165, 31, 36, 0.18); }
  .card[aria-expanded='true'] { border-color: var(--blood); }
  @keyframes card-in { from { opacity: 0; transform: translateY(10px); } }
  .card__thumb { position: relative; display: block; height: 190px; overflow: hidden; background: radial-gradient(circle at 70% 40%, var(--glow), #0a0a0b 65%); }
  .card__thumb[data-status='COMPLETED'] { --glow: rgba(52, 56, 61, 0.6); }
  .card__thumb[data-status='ACTIVE'] { --glow: rgba(165, 31, 36, 0.55); }
  .card__thumb[data-status='UPCOMING'] { --glow: rgba(113, 128, 140, 0.25); }
  .card__thumb::before { content: ''; position: absolute; inset: 0; z-index: 1; background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 4px), linear-gradient(90deg, transparent calc(50% - 0.5px), rgba(113, 128, 140, 0.2) 50%, transparent calc(50% + 0.5px)), linear-gradient(0deg, transparent calc(50% - 0.5px), rgba(113, 128, 140, 0.2) 50%, transparent calc(50% + 0.5px)); }
  .card__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .card__ph { position: absolute; left: 20px; top: 18px; font-size: 11px; color: var(--muted); z-index: 2; }
  .card__num { position: absolute; left: 20px; bottom: 6px; z-index: 2; font-family: var(--f-display); font-weight: 800; font-size: 96px; line-height: 1; color: rgba(215, 215, 215, 0.08); }
  .card__thumb .status-tag { position: absolute; right: 16px; top: 16px; z-index: 2; }
  .card__body { display: flex; flex-direction: column; gap: 10px; padding: 22px 22px 24px; }
  .card__meta { display: flex; justify-content: space-between; font-size: 11px; color: var(--steel); }
  .card__title { font-family: var(--f-display); font-weight: 700; font-size: 32px; line-height: 1; letter-spacing: 0.03em; }
  .card__summary { font-size: 14px; line-height: 1.55; color: var(--muted); }
  .card__stats { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 6px; font-size: 11px; letter-spacing: 0.14em; color: var(--muted); }
  .card__stats b { font-weight: 400; color: var(--white); }

  .archive__dossiers { position: sticky; top: 24px; border: 1px solid var(--blood); background: linear-gradient(180deg, var(--black-red) 0%, #0b0b0c 40%); }
  .dossier-close { display: none; }

  @media (max-width: 1180px) { .archive__layout { grid-template-columns: minmax(0, 1fr) minmax(320px, 380px); } .archive__grid { grid-template-columns: 1fr; } }
  /* Móvil: el expediente se abre como una hoja desde abajo */
  @media (max-width: 860px) {
    .archive__layout { grid-template-columns: 1fr; }
    .archive__grid { grid-template-columns: 1fr; gap: 14px; }
    .archive__shown { display: none; }
    .archive__filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .archive__filters .chip { flex: none; }
    .card__thumb { height: 140px; }
    .archive__dossiers {
      position: fixed; inset: auto 0 0 0; top: 8vh; z-index: 60; overflow: auto; border-width: 1px 0 0;
      transform: translateY(105%); transition: transform 0.45s var(--ease), visibility 0s 0.45s; visibility: hidden; overscroll-behavior: contain;
    }
    .archive__dossiers[data-open='true'] { transform: none; visibility: visible; transition: transform 0.45s var(--ease); }
    .dossier-close {
      display: flex; position: sticky; top: 10px; margin: 10px 10px -54px auto; z-index: 2; width: 44px; height: 44px; align-items: center; justify-content: center;
      border-radius: 50%; background: rgba(8, 8, 8, 0.85); border: 1px solid var(--line-strong); cursor: pointer;
    }
  }
</style>

<style is:global>
  .status-tag {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; background: rgba(8, 8, 8, 0.8);
    border: 1px solid var(--st); color: var(--st); font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.18em;
  }
  .status-tag span { width: 6px; height: 6px; border-radius: 50%; background: var(--st); }
  .status-tag[data-status='COMPLETED'] { --st: #9aa6b0; }
  .status-tag[data-status='ACTIVE'] { --st: #FF3737; }
  .status-tag[data-status='ACTIVE'] span { animation: mz-pulse 1.6s infinite; }
  .status-tag[data-status='UPCOMING'] { --st: #D7D7D7; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-card]')];
    const wraps = [...root.querySelectorAll<HTMLElement>('[data-card-wrap]')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const panel = root.querySelector<HTMLElement>('[data-dossiers]')!;
    const shown = root.querySelector<HTMLElement>('[data-shown]')!;
    const mobile = matchMedia('(max-width: 860px)');

    const open = (id: string, fromUser = true) => {
      const target = panel.querySelector<HTMLElement>(`[data-dossier="${id}"]`);
      if (!target) return;
      panel.querySelectorAll<HTMLElement>('[data-dossier]').forEach((d) => (d.hidden = d !== target));
      cards.forEach((c) => c.setAttribute('aria-expanded', String(c.dataset.card === id)));
      target.classList.remove('is-booting'); void target.offsetWidth; target.classList.add('is-booting');
      if (fromUser) history.replaceState(null, '', '#' + id);
      if (mobile.matches && fromUser) { panel.dataset.open = 'true'; document.body.style.overflow = 'hidden'; panel.querySelector<HTMLElement>('[data-dossier-close]')?.focus(); }
    };
    const close = () => { panel.dataset.open = 'false'; document.body.style.overflow = ''; };

    cards.forEach((c) => c.addEventListener('click', () => open(c.dataset.card!)));
    panel.querySelector('[data-dossier-close]')?.addEventListener('click', close);
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel.dataset.open === 'true') close(); });

    filters.forEach((f) => f.addEventListener('click', () => {
      const k = f.dataset.filter!;
      filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      let n = 0;
      wraps.forEach((w) => { const on = k === 'ALL' || w.dataset.status === k; w.hidden = !on; if (on) n++; });
      shown.textContent = String(n).padStart(2, '0');
    }));

    const hash = decodeURIComponent(location.hash.slice(1));
    if (hash && cards.some((c) => c.dataset.card === hash)) open(hash, false);
  }
</script>
