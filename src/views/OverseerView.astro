---
// Maqueta del área administrativa. NO es privada (GitHub Pages es estático):
// no se indexa y no muestra datos reales. La versión real requiere autenticación + backend.
import Base from '../layouts/Base.astro';
import type { Lang } from '../data/site';
import { ui } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].overseer;
const rows: [string, string, keyof typeof t.st][] = [
  ['ARTIST SLOT 01', '3D Modeling · Texturing', 'NEW'], ['ARTIST SLOT 02', 'Concept Art', 'NEW'],
  ['ARTIST SLOT 03', 'Rigging · Animation', 'REV'], ['ARTIST SLOT 04', 'Environment Art', 'REV'],
  ['ARTIST SLOT 05', 'VFX · Motion Graphics', 'OK'], ['ARTIST SLOT 06', 'Sound Design', 'CON'],
];
---
<Base lang={lang} slug="overseer" title={t.title} description={t.description} noindex>
  <div class="console">
    <nav class="console__side" aria-label="Overseer">
      <p class="console__brand">OVERSEER</p>
      {t.menu.map((m, i) => <span class:list={['console__item mono', { on: i === 0 }]}>{m}{i === 0 && <b>[N]</b>}</span>)}
      <div class="console__lock mono">{t.restrictedK}<br />{t.restrictedP}</div>
    </nav>
    <section class="console__main">
      <p class="kicker" style="font-size:11px">{t.kicker}</p>
      <h1>{t.h1}</h1>
      <div class="console__stats">{t.stats.map((s, i) => <div><span class="mono">{s}</span><b style={i === 0 ? 'color:var(--red)' : ''}>[N]</b></div>)}</div>
      <div class="console__body">
        <div class="console__table">
          <table>
            <thead><tr>{t.th.map((h) => <th class="mono">{h}</th>)}</tr></thead>
            <tbody>
              {rows.map(([n, s, st], i) => (
                <tr class:list={{ sel: i === 0 }}><td><span class="av"></span>{n}</td><td class="muted">{s}</td><td class="mono muted">[DD.MM]</td><td><span class="st mono" data-st={st}>{t.st[st]}</span></td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <aside class="console__profile">
          <p class="console__pname">ARTIST SLOT 01</p>
          <p class="mono muted" style="font-size:11px">{t.mail}</p>
          <p class="muted" style="font-size:13px;line-height:1.6">{t.profileP}</p>
          <div class="console__actions"><button class="btn btn--solid btn--sm" disabled>{t.contact}</button><button class="btn btn--ghost btn--sm" disabled>{t.approve}</button></div>
        </aside>
      </div>
    </section>
  </div>
</Base>

<style>
  .console { display: flex; flex-wrap: wrap; min-height: 80vh; }
  .console__side { flex: 1 1 240px; max-width: 280px; padding: 28px 20px; border-right: 1px solid var(--line-soft); background: #0b0c0d; display: flex; flex-direction: column; gap: 6px; }
  .console__brand { font-family: var(--f-display); font-weight: 700; font-size: 18px; letter-spacing: 0.28em; padding: 0 8px 24px; }
  .console__item { display: flex; justify-content: space-between; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px; border: 1px solid transparent; font-size: 12px; color: var(--muted); }
  .console__item.on { background: var(--black-red); border-color: var(--blood); color: var(--white); }
  .console__item b { font-weight: 400; color: var(--red); }
  .console__lock { margin-top: auto; padding: 16px 12px; border: 1px solid var(--line-strong); font-size: 10px; line-height: 1.7; color: var(--muted); text-transform: none; letter-spacing: 0.08em; }
  .console__main { flex: 999 1 640px; min-width: 0; padding: 36px var(--gutter); }
  .console__main h1 { margin-top: 10px; font-size: clamp(44px, 5vw, 64px); }
  .console__stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin-top: 32px; background: var(--line-soft); border: 1px solid var(--line-soft); }
  .console__stats div { background: var(--panel); padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .console__stats span { font-size: 10px; color: var(--muted); }
  .console__stats b { font-family: var(--f-display); font-size: 40px; }
  .console__body { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 28px; align-items: flex-start; }
  .console__table { flex: 999 1 520px; min-width: 0; overflow-x: auto; border: 1px solid var(--line); }
  table { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 13px; }
  th { background: var(--panel); padding: 14px 16px; font-weight: 500; font-size: 10px; color: var(--muted); text-align: left; }
  td { padding: 14px 16px; border-top: 1px solid rgba(113, 128, 140, 0.15); }
  tr.sel { background: rgba(165, 31, 36, 0.12); }
  td:first-child { display: flex; align-items: center; gap: 12px; }
  .av { width: 32px; height: 32px; border-radius: 50%; background: var(--metal); }
  .st { padding: 4px 8px; border: 1px solid currentColor; font-size: 10px; color: var(--muted); }
  .st[data-st='NEW'] { color: var(--red); } .st[data-st='REV'] { color: var(--white); }
  .console__profile { flex: 1 1 300px; border: 1px solid var(--blood); background: var(--black-red); padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .console__pname { font-family: var(--f-display); font-weight: 700; font-size: 26px; }
  .console__actions { display: flex; gap: 10px; }
  @media (max-width: 760px) { .console__side { max-width: none; border-right: 0; border-bottom: 1px solid var(--line-soft); } .console__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
